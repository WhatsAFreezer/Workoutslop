{
  "name": "workoutslop",
  "productName": "Workoutslop",
  "version": "0.1.0",
  "description": "Motionsoverlay til computerspil – foreslår øvelser i pauserne mellem kampene.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dk.workoutslop.app",
    "productName": "Workoutslop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Workoutslop-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Workoutslop-${version}-portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.healthcare-fitness",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "assets/icon.png"
    }
  }
}
