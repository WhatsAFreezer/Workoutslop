{
  "name": "workoutslop",
  "productName": "Workoutslop",
  "version": "0.1.4",
  "description": "Motionsoverlay til computerspil – foreslår øvelser i pauserne mellem kampene.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "release": "npm version patch && git push --follow-tags"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^2.16.3"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dk.workoutslop.app",
    "productName": "Workoutslop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/koffi/{src,vendor,doc}/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/build/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png",
      "files": [
        "!node_modules/koffi/build/koffi/{darwin,freebsd,linux,musl,openbsd}_*/**",
        "!node_modules/koffi/build/koffi/win32_{arm64,ia32}/**"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Workoutslop",
      "uninstallDisplayName": "Workoutslop",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Workoutslop-Setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.healthcare-fitness",
      "icon": "assets/icon.png",
      "files": [
        "!node_modules/koffi/build/koffi/{freebsd,linux,musl,openbsd,win32}_*/**"
      ]
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "assets/icon.png",
      "files": [
        "!node_modules/koffi/build/koffi/{darwin,freebsd,musl,openbsd,win32}_*/**"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "WhatsAFreezer",
        "repo": "Workoutslop",
        "releaseType": "release"
      }
    ]
  }
}
